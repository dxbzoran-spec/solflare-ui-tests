{
  "name": "solflare-ui-tests",
  "version": "1.0.0",
  "description": "End-to-end test for the Solflare web wallet (onboarding + wallet management) - WebdriverIO + TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:chrome": "node scripts/run.mjs --browser=chrome",
    "test:firefox": "node scripts/run.mjs --browser=firefox",
    "test:headless": "node scripts/run.mjs --headless",
    "test:chrome:headless": "node scripts/run.mjs --browser=chrome --headless",
    "test:firefox:headless": "node scripts/run.mjs --browser=firefox --headless",
    "typecheck": "tsc --noEmit",
    "report": "allure generate reports/allure-results -o reports/allure-report && allure open reports/allure-report",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure": "^3.22.1",
    "expect-webdriverio": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "webdriverio": "^9.32.0",
    "winston": "^3.19.0"
  }
}
